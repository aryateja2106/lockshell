# SPDX-License-Identifier: Apache-2.0
#
# Hardened sshd_config for lockshell-managed targets.
#
# Goal: zero-trust-by-default. The only way to authenticate is with a
# user certificate signed by the lockshell CA. No passwords, no static
# authorized_keys files, no host-key bypass tricks. Drop this in at
# /etc/ssh/sshd_config.d/lockshell.conf (or substitute the whole sshd_config)
# and reload sshd.
#
# Distribute the lockshell CA public key to /etc/ssh/lockshell_ca.pub on
# every target. `lockshell ca print` prints it. `lockshell ca rotate` cuts
# a new one and invalidates outstanding certs.

# --- Authentication: certs only ----------------------------------------
PasswordAuthentication no
ChallengeResponseAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PubkeyAuthentication yes

# Trust certificates signed by the lockshell CA.
TrustedUserCAKeys /etc/ssh/lockshell_ca.pub

# Disable static authorized_keys to prevent accidental key sprawl.
AuthorizedKeysFile none

# --- Account boundaries ------------------------------------------------
PermitRootLogin no
# AllowUsers must be set per-host. Example:
# AllowUsers deploy ops

# --- Rate limit + logging ----------------------------------------------
MaxAuthTries 3
MaxSessions 5
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2
LogLevel VERBOSE

# --- Crypto: modern only -----------------------------------------------
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,sntrup761x25519-sha512@openssh.com
HostKeyAlgorithms ssh-ed25519,ecdsa-sha2-nistp256
PubkeyAcceptedAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,ecdsa-sha2-nistp256,ecdsa-sha2-nistp256-cert-v01@openssh.com
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com

# --- Forwarding: off by default; certs already restrict this ----------
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PrintMotd no
UseDNS no
